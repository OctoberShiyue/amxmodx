import os.path

binary = AMXX.MetaModule(builder, 'hamsandwichl')

binary.compiler.defines += [
  'HAVE_STDINT_H',
]

binary.compiler.cxxincludes += [
  os.path.join(builder.currentSourcePath, 'lualib'),
]

binary.sources = [
  '../../public/sdk/amxxmodule.cpp',
  '../../public/memtools/MemoryUtils.cpp',
  'amxx_api.cpp',
  'config_parser.cpp',
  'hook_callbacks.cpp',
  'hook_native.cpp',
  'srvcmd.cpp',
  'call_funcs.cpp',
  'hook_create.cpp',
  'DataHandler.cpp',
  'pdata.cpp',
  'hook_specialbot.cpp',
  'lualib/ljamalg.c',
]

if builder.target_platform == 'windows':
    binary.sources += ['version.rc']
    binary.compiler.linkflags += [
      '/EXPORT:GiveFnptrsToDll=_GiveFnptrsToDll@8,@1',
      '/SECTION:.data,RW',
      os.path.join(builder.currentSourcePath, 'lualib', 'lj_vm.obj')
    ]

AMXX.modules += [builder.Add(binary)]
